QDRANT_URL=
QDRANT_API_KEY=

GROQ_API_KEY=
GROQ_MODEL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Set to "true" to enable the legacy /bookmark and /search endpoints, which
# call out to the embedding service on first use. Leave unset/"false" on
# deployments where the embedding service isn't running.
EMBEDDINGS_ENABLED=false

# Base URL of the standalone embedding service (see embedding_service/).
# Used by app/embedding.py's get_embedding() when EMBEDDINGS_ENABLED=true.
EMBEDDING_SERVICE_URL=http://localhost:8001
